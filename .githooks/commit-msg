#!/bin/sh
# Commit-message guard — enforces docs/conventions.md § Commits. Armed per clone by
# `make hooks` (git config core.hooksPath .githooks); it binds humans and pipeline
# agents alike, on every branch.
#
# Measured 2026-09-01 against svu v3.4.1 (the release.yml pin): a breaking footer
# forces a major bump on ANY type and matches the phrase anywhere in the message —
# mid-sentence, hyphenated, in a body or trailer — and `!` forces major on every
# type, known or not. release.yml passes --v0 so 0.x clamps those to minor, but a
# release still cuts; this hook is what makes both deliberate.

msg_file="$1"
# Strip comment lines; git hasn't removed them yet at commit-msg time.
msg=$(grep -v '^#' "$msg_file")
subject=$(printf '%s\n' "$msg" | head -n1)

fail() {
  echo "commit-msg guard: $1" >&2
  echo "  subject: $subject" >&2
  echo "  rules: docs/conventions.md § Commits" >&2
  exit 1
}

# Porcelain-generated merge subjects pass through untouched.
case "$subject" in
  "Merge "*) exit 0 ;;
esac

# The breaking footer/phrase is banned outright — svu matches it anywhere in the
# message, so even a body that merely mentions it cuts a release. Use `!` instead.
if printf '%s\n' "$msg" | grep -qiE 'BREAKING[- ]CHANGE'; then
  fail "the breaking footer/phrase may not appear anywhere in a commit message; mark a breaking change with '!' instead"
fi

# type(scope)!: imperative summary
if ! printf '%s\n' "$subject" | grep -qE '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|review)(\([^)]*\))?!?: .+'; then
  fail "subject must be 'type(scope): summary' with a known type (build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test; review on plan branches only)"
fi

type=$(printf '%s\n' "$subject" | sed -E 's/^([a-z]+).*/\1/')
branch=$(git symbolic-ref --quiet --short HEAD || echo detached)

# review(<plan>) is the review agent's plan-branch verdict commit; the /land squash
# is what reaches main, so a review subject on main is always a mistake.
if [ "$type" = review ] && [ "$branch" = main ]; then
  fail "'review' commits belong on plan branches only, never on main"
fi

# `!` is the only breaking marker and needs an explicit human decision:
# MUSTER_BREAKING=1 git commit ... — agents never set it.
if printf '%s\n' "$subject" | grep -qE '^[a-z]+(\([^)]*\))?!:' && [ "${MUSTER_BREAKING:-}" != 1 ]; then
  fail "'!' marks a breaking change and requires MUSTER_BREAKING=1 set by a human"
fi

# Paths that ship nothing: tests, E2E, dev tooling not in the binary (`go list -deps
# ./cmd/musterd` carries neither internal/kb nor internal/triage), docs, pipeline files
# and build/lint config. Anything else counts as shipped, so this list can only ever
# miss a case — never block an honest release.
unshipped='(_test\.go|\.test\.ts)$|^(web/e2e|web/scripts|test|tools|internal/kb|internal/triage|docs|plans|\.claude|\.github|\.githooks)/|(\.md|\.json|\.ya?ml)$|^Makefile$|\.config\.(ts|js|mjs)$'

# The four release-worthy types cut a version and publish their subject verbatim as a
# release-note bullet. Only main publishes — plan-branch subjects (e.g. fix(<plan>): …
# (review cycle N)) are squashed away — so all three rules below bind on main only.
case "$branch:$type" in
  main:feat|main:fix|main:perf|main:refactor)
    # The summary (after 'type(scope): ', before any '(closes #N)' tail) caps at 72.
    summary=${subject#*: }
    summary=$(printf '%s' "$summary" | sed -E 's/ \(closes #[0-9]+(, closes #[0-9]+)*\)$//')
    if [ "${#summary}" -gt 72 ]; then
      fail "a $type summary is a published release note and caps at 72 chars before the (closes …) tail (got ${#summary})"
    fi

    # A releasing type whose scope is 'test' contradicts itself: the scope names the
    # thing changed, and a change to the tests is a `test` commit.
    if printf '%s\n' "$subject" | grep -qE '^[a-z]+\(test\)!?:'; then
      fail "'$type(test)' contradicts itself — a change to the tests is a 'test' commit, which releases nothing"
    fi

    # A release is for the shipped artifact: the musterd binary and the embedded
    # dashboard. A lint pass typed `refactor`/`fix(test)` published seven notes for
    # test- and tooling-only commits across v0.12.4 and v0.12.5; this is the guard.
    # MUSTER_RELEASE=1 is the human override for the rare unshipped file that does
    # change what users receive (release packaging, the install path).
    if [ "${MUSTER_RELEASE:-}" != 1 ] &&
      ! git diff --cached --name-only | grep -qvE "$unshipped"; then
      fail "a $type cuts a release, but no staged file changes the shipped artifact (musterd or web/src) — use test, chore, build or docs; MUSTER_RELEASE=1 overrides"
    fi
    ;;
esac

# A triage pass files backlog entries and nothing else. The staged set is checked here
# rather than in pre-commit because only this hook sees the subject, and the rule is
# subject-conditioned: ordinary commits touch TODO.md alongside code all the time.
#
# `go run ./tools/triage apply` verifies the same thing before it commits; this is the
# half that still holds when something other than that tool wrote the commit.
if printf '%s\n' "$subject" | grep -q '^docs(triage):'; then
  staged=$(git diff --cached --name-only)
  if [ "$staged" != "TODO.md" ]; then
    fail "a docs(triage) commit may stage only TODO.md (staged: $(printf '%s' "$staged" | tr '\n' ' '))"
  fi
  if printf '%s\n' "$subject" | grep -qiE '\b(close[sd]?|fix(e[sd])?|resolve[sd]?) #[0-9]'; then
    fail "a triage subject must never carry a closing keyword — it would close the issues it just filed"
  fi
fi

exit 0
