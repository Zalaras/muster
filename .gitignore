# Go
/bin/
*.test
*.out

# GoReleaser build output (make release-check / goreleaser release --snapshot)
/dist/

# SQLite (daemon state; never committed)
*.db
*.db-wal
*.db-shm

# Node / frontend
node_modules/
# Historic: pre-embed-dashboard Vite output dir; stale checkouts may still have one.
web/dist/
web/.vite/

# Embedded dashboard build output (plan embed-dashboard REQ-4/REQ-5): the built assets
# are gitignored, but .gitkeep is committed so `//go:embed all:assets` always resolves
# on a fresh clone even before `make web-build` has ever run.
internal/webui/assets/*
!internal/webui/assets/.gitkeep

# Playwright
/web/test-results/
/web/playwright-report/
/web/blob-report/

# Interface-probe rig captured payloads (instances live in /tmp/muster-probe)
/test/rig/captures/

# Local, machine-specific
.DS_Store
.env
.env.local
/local/

# Claude Code: the project settings.json IS committed (it is the AI build harness
# config, next-steps.md item 3). Only personal overrides are ignored.
.claude/settings.local.json

# Playwright MCP scratch output
/.playwright-mcp/
