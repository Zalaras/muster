{
  "name": "muster-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Muster dashboard. Vite + TypeScript, no framework.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "sh scripts/e2e-lint.sh && playwright test",
    "e2e:lint": "sh scripts/e2e-lint.sh",
    "e2e:fixture-leak-check": "node scripts/e2e-fixture-leak-check.mjs",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
