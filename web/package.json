{
  "name": "muster-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Muster dashboard. Vite + TypeScript, no framework.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check . && node scripts/shape-lint.mjs",
    "shape:lint": "node scripts/shape-lint.mjs",
    "lint:fix": "biome check --write .",
    "e2e": "sh scripts/e2e-lint.sh && playwright test",
    "e2e:lint": "sh scripts/e2e-lint.sh",
    "e2e:fixture-leak-check": "node scripts/e2e-fixture-leak-check.mjs",
    "render-test": "sh scripts/render-lint.sh && playwright test -c playwright.render.config.ts",
    "render:lint": "sh scripts/render-lint.sh",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "mermaid": "12.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
